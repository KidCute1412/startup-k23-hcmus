DATABASE_URL="postgresql://postgres:mysecretpassword@localhost:5432/mutux_db?schema=public"

# Server configuration
# Backend dùng 8080; frontend dùng 3000.
PORT=8080
FRONTEND_URL="http://localhost:3000"
UPLOADS_DIR="./uploads"

# JWT Secrets
JWT_SECRET="fallbackSecretTokenForWeek1Dev"
JWT_REFRESH_SECRET="fallbackRefreshSecretTokenForWeek1Dev"

# PayOS production/sandbox credentials.
# Điền các giá trị lấy từ PayOS Dashboard.
PAYOS_CLIENT_ID="your-payos-client-id"
PAYOS_API_KEY="your-payos-api-key"
PAYOS_CHECKSUM_KEY="your-payos-checksum-key"

# Vẫn giữ biến này cho webhook mock hiện tại của project.
PAYOS_WEBHOOK_SECRET="test-secret"
