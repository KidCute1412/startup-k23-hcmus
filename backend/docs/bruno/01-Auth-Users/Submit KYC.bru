meta {
  name: Submit KYC
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/users/me/kyc
  body: json
  auth: inherit
}

body:json {
  {
    "cccd": "012345678912",
    "frontCardUrl": "{{proofFileUrl}}",
    "backCardUrl": "{{proofFileUrl}}",
    "portraitUrl": "{{proofFileUrl}}"
  }
}

headers {
  Origin: http://localhost:3000
}
