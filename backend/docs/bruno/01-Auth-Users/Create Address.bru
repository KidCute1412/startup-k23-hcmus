meta {
  name: Create Address
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/users/me/addresses
  body: json
  auth: inherit
}

body:json {
  {
    "receiverName": "Mutux Demo",
    "phone": "0908123456",
    "detailAddress": "227 Nguyễn Văn Cừ",
    "ward": "Phường 4",
    "district": "Quận 5",
    "province": "TP. Hồ Chí Minh",
    "isDefault": false
  }
}

headers {
  Origin: http://localhost:3000
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("addressId", res.body.data.id);
  }
}
