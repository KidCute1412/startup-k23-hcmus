meta { name: Batch Checkout Insufficient Cash type: http seq: 13 }
post { url: {{baseUrl}}/rental-orders/batch body: json auth: inherit }
headers { Origin: http://localhost:3000 }
body:json {
  { "cartItemIds": ["{{cartItemId}}"], "depositType": "traditional", "addressId": "{{addressId}}" }
}
tests { test("rejects checkout without removing the cart item when cash is insufficient", function () { expect(res.status).to.equal(400); expect(res.body.success).to.equal(false); expect(res.body.error.code).to.equal("INSUFFICIENT_CASH"); }); }
