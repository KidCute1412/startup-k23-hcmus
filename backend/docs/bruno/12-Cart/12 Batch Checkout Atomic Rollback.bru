meta { name: Batch Checkout Atomic Rollback type: http seq: 12 }
post { url: {{baseUrl}}/rental-orders/batch body: json auth: inherit }
headers { Origin: http://localhost:3000 }
body:json {
  { "cartItemIds": ["{{cartItemId}}", "{{secondCartItemId}}"], "depositType": "traditional", "shippingName": "Nguyễn Văn A", "shippingPhone": "0987654321", "shippingAddress": "TP.HCM" }
}
tests { test("invalid batch is wholly rejected", function () { expect([400,404,409]).to.include(res.status); expect(res.body.success).to.equal(false); }); }
