meta { name: Batch Checkout type: http seq: 10 }
post { url: {{baseUrl}}/rental-orders/batch body: json auth: inherit }
headers { Origin: http://localhost:3000 }
body:json {
  { "cartItemIds": ["{{cartItemId}}"], "depositType": "traditional", "addressId": "{{addressId}}" }
}
tests { test("creates orders and removes selected", function () { expect(res.status).to.equal(201); expect(res.body.data.orders.length).to.equal(res.body.data.removedCartItemIds.length); }); }
