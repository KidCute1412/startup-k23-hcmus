meta {
  name: Resolve Dispute Missing Deduct Amount
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/admin/disputes/{{disputeId}}/resolve
  body: json
  auth: inherit
}

body:json {
  {
    "resolutionType": "lender_compensation"
  }
}

tests {
  test("returns 400 validation error when lender_compensation lacks deductAmount", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().success).to.equal(false);
  });
}
