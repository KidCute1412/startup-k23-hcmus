meta {
  name: Get Dispute Queue
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/admin/disputes?status=open&page=1&limit=10
  body: none
  auth: inherit
}

tests {
  test("returns the paginated dispute queue", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array");
    expect(res.body.meta).to.include.keys("total", "page", "limit", "totalPages");
  });
}
