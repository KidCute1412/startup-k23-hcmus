meta {
  name: Resolve Dispute
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/admin/disputes/{{disputeId}}/resolve
  body: json
  auth: inherit
}

tests {
  test("resolves the dispute", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().data.status).to.equal("resolved");
    expect(res.getBody().data.resolutionType).to.equal("deposit_deduct");
    expect(res.getBody().data.deductAmount).to.equal(1500000);
  });
}

body:json {
  {
    "resolutionType": "deposit_deduct",
    "deductAmount": 1500000,
    "resolutionNote": "Khấu trừ 1.500.000đ do làm nứt vỏ nhôm"
  }
}

docs {
  # POST /api/v1/admin/disputes/:id/resolve
  
  Atomically updates dispute status and triggers financial settlement via `EscrowService` within a single `prisma.$transaction`. `no_action` follows the same release path as `refund` and does not accept `deductAmount`.
  
  ## Resolution Types & Expected Balances
  
  ### 1. `resolutionType = "deposit_deduct"` (deductAmount = X)
  - **Traditional Deposit (`renter_cash`)**:
    - Renter cash `balance` -= X
    - Renter cash `locked_balance` -= escrow.amount (remaining `escrow.amount - X` unlocked)
    - Lender `balance` += lenderIncome (rental_fee * 0.85) + X
    - Escrow status -> `compensated`
  - **Credit Line (`credit_line`)**:
    - Renter `outstanding_debt` += X
    - Renter `locked_balance` -= escrow.amount
    - Renter `display_balance` recalculated as `total_limit - locked_balance - outstanding_debt`
    - Lender `balance` += lenderIncome + X
    - Escrow status -> `compensated`

  ### 2. `resolutionType = "refund"`
  - **Traditional Deposit (`renter_cash`)**:
    - Renter cash `locked_balance` -= escrow.amount (full deposit unlocked)
    - Lender `balance` += lenderIncome
    - Escrow status -> `released`
  - **Credit Line (`credit_line`)**:
    - Renter `locked_balance` -= escrow.amount
    - Renter `display_balance` += escrow.amount
    - Lender `balance` += lenderIncome
    - Escrow status -> `released`

  ## Idempotency
  - If called when dispute status is already `resolved`, returns `200` with existing dispute.
  - `EscrowService` is NOT invoked a second time (no balance/ledger side effects).
}

