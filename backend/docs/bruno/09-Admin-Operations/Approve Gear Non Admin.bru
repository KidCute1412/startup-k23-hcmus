meta {
  name: Approve Gear Non Admin
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/admin/gears/{{gearId}}/approve
  body: none
  auth: inherit
}

tests {
  test("rejects the current non-admin session", function() {
    expect(res.status).to.equal(403);
    expect(res.body.error.code).to.equal("ADMIN_ONLY");
  });
}
