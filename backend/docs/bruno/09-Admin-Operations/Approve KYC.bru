meta {
  name: Approve KYC
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/admin/kyc/{{kycUserId}}/approve
  body: none
  auth: inherit
}

tests {
  test("approves the KYC profile", function() {
    expect(res.status).to.equal(201);
    expect(res.body.data.kyc_status).to.equal("verified");
  });
}
