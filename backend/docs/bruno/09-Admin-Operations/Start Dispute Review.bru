meta {
  name: Start Dispute Review
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/admin/disputes/{{disputeId}}/start-review
  body: none
  auth: inherit
}

tests {
  test("moves an open dispute to under_review", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("under_review");
  });
}
