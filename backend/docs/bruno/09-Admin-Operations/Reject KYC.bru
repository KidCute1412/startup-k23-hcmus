meta {
  name: Reject KYC
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/admin/kyc/{{kycUserId}}/reject
  body: json
  auth: inherit
}

body:json {
  {
    "reason": "Identity document is unreadable"
  }
}

tests {
  test("rejects the KYC profile", function() {
    expect(res.status).to.equal(201);
    expect(res.body.data.kyc_status).to.equal("rejected");
  });
}
