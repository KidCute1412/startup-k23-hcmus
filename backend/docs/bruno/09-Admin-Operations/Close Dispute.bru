meta {
  name: Close Dispute
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/admin/disputes/{{disputeId}}/close
  body: json
  auth: inherit
}

tests {
  test("closes a resolved dispute without settlement", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("closed");
  });
}

body:json {
  {
    "closeNote": "Hồ sơ đã hoàn tất và không còn khiếu nại bổ sung."
  }
}
