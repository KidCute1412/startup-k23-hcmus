meta {
  name: Get Proofs
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/rental-orders/{{rentalOrderId}}/proofs
  body: none
  auth: inherit
}

tests {
  test("returns proofs oldest first", function() {
    expect(res.status).to.equal(200);
    const timestamps = res.body.data.map((proof) => proof.uploadedAt);
    expect(timestamps).to.deep.equal([...timestamps].sort());
  });
}
