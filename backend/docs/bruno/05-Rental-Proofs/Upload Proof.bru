meta {
  name: Create Proof
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/rental-orders/{{rentalOrderId}}/proofs
  body: json
  auth: inherit
}

body:json {
  {
    "stage": "{{proofStage}}",
    "fileUrl": "{{proofFileUrl}}",
    "note": "Hộp đầy đủ cáp và keycap"
  }
}

headers {
  Origin: http://localhost:3000
}

tests {
  test("creates an image proof", function() {
    expect(res.status).to.equal(201);
    expect(res.body.data.proofType).to.equal("image");
  });
}

docs {
  Set `proofStage` and `proofFileUrl` for the current actor:

  - before ship: lender uploads `pre_shipment` while order is `confirmed`
  - after return: renter uploads `pre_return` while order is `returning`
  - before confirm-return: lender uploads `post_returned` while order is `returning`
}
