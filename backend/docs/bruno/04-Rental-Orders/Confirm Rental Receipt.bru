meta {
  name: Confirm Rental Receipt
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/rental-orders/{{rentalOrderId}}/confirm-receipt
  body: none
  auth: inherit
}

headers {
  Origin: http://localhost:3000
}

tests {
  test("renter confirms receipt", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.status).to.equal("active");
  });
}

docs {
  # Prerequisite
  Switch to the renter session after lender ships the order (`delivering`).
}
