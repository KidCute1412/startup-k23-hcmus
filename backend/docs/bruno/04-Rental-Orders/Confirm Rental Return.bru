meta {
  name: Confirm Rental Return
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/rental-orders/{{rentalOrderId}}/confirm-return
  body: none
  auth: inherit
}

headers {
  Origin: http://localhost:3000
}

tests {
  test("settles once and completes the order", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.status).to.equal("completed");
  });
}

docs {
  # Prerequisites
  Run as lender while the order is `returning`, after both proofs exist:
  - renter `pre_return`
  - lender `post_returned`

  Missing either proof returns `400 PROOF_REQUIRED` without settlement. Retry after completion returns `completed` without releasing escrow or crediting lender twice.
}
