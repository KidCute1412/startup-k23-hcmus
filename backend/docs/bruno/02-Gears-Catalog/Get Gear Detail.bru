meta {
  name: Get Gear Detail
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/gears/30000000-0000-0000-0000-000000000001
  body: none
  auth: none
}

tests {
  test("returns safe detail media and gear reviews", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.id).to.equal("30000000-0000-0000-0000-000000000001");
    expect(res.body.data.media).to.be.an("array");
    expect(res.body.data.reviews).to.be.an("array");
    expect(res.body.data.lender).not.to.include.keys("email", "phone", "password_hash", "cccd", "address");
  });
}
