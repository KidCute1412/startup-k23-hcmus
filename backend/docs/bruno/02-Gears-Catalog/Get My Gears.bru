meta {
  name: Get My Gears
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/gears/mine?page=1&limit=10&search=&status=all
  body: none
  auth: inherit
}

tests {
  test("returns the authenticated lender's paginated gears", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array");
    expect(res.body.meta).to.include.keys("total", "page", "limit", "totalPages");
  });
}
