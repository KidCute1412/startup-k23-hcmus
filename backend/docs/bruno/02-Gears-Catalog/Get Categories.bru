meta {
  name: Get Categories
  type: http
  seq: 1
}

tests {
  test("returns camelCase category parents", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array");
    if (res.body.data.length) {
      expect(res.body.data[0]).to.have.property("parentId");
      expect(res.body.data[0]).not.to.have.property("parent_id");
    }
  });
}

get {
  url: {{baseUrl}}/categories
  body: none
  auth: none
}
