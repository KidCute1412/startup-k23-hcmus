meta {
  name: Submit Dispute
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/disputes
  body: json
  auth: inherit
}

body:json {
  {
    "rentalOrderId": "{{rentalOrderId}}",
    "reason": "device_damaged",
    "description": "Bàn phím bị nứt góc nhôm",
    "evidences": [
      {
        "mediaType": "image",
        "url": "{{disputeEvidenceUrl}}"
      }
    ]
  }
}

tests {
  test("creates a dispute", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().data.rentalOrderId).to.equal(bru.getVar("rentalOrderId"));
    expect(res.getBody().data.reporterRole).to.be.oneOf(["renter", "lender"]);
    expect(res.getBody().data.evidences).to.have.lengthOf(1);
  });
}
