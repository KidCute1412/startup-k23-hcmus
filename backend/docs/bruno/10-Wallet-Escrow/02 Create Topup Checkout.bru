meta {
  name: Create Topup Checkout For Webhook
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/wallets/topups/checkout
  body: json
  auth: inherit
}

body:json {
  {
    "amount": 500000,
    "method": "payos"
  }
}

script:post-response {
  if (res.status === 201) {
    const topup = res.body.data;
    bru.setEnvVar("topupId", topup.topupId);
    bru.setEnvVar("topupOrderCode", String(topup.orderCode));
    bru.setEnvVar("topupAmount", String(topup.amount));
  }
}

tests {
  test("creates pending topup", function() {
    expect(res.status).to.equal(201);
    expect(res.body.data).to.have.property("topupId");
    expect(res.body.data.orderCode).to.be.a("number");
  });
}
