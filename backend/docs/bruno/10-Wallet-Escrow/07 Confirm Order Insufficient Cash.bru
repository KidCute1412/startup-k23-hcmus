meta {
  name: Confirm Order Insufficient Cash
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/rental-orders/{{insufficientCashOrderId}}/confirm
  body: none
  auth: inherit
}

tests {
  test("rejects confirmation when renter cash is insufficient", function() {
    expect(res.status).to.equal(400);
    expect(res.body.error.code).to.equal("INSUFFICIENT_CASH");
  });
}
