meta {
  name: PayOS Webhook Valid Signature
  type: http
  seq: 4
}
post {
  url: {{baseUrl}}/payments/webhook/payos
  body: json
  auth: none
}
headers {
  x-payos-signature: {{payosSignature}}
}
body:json {
  {
    "code": "00",
    "success": true,
    "data": {
      "orderCode": {{topupOrderCode}},
      "amount": {{topupAmount}},
      "reference": "{{payosReference}}"
    }
  }
}
script:pre-request {
  const crypto = require("crypto");
  const stable = (value) => Array.isArray(value)
    ? `[${value.map(stable).join(",")}]`
    : value && typeof value === "object"
      ? `{${Object.keys(value).sort().map((key) => `${JSON.stringify(key)}:${stable(value[key])}`).join(",")}}`
      : JSON.stringify(value);
  const reference = `PAYOS-REF-${Date.now()}`;
  const payload = { code: "00", success: true, data: { orderCode: Number(bru.getEnvVar("topupOrderCode")), amount: Number(bru.getEnvVar("topupAmount")), reference } };
  bru.setEnvVar("payosReference", reference);
  bru.setEnvVar("payosSignature", crypto.createHmac("sha256", bru.getEnvVar("PAYOS_WEBHOOK_SECRET") || "test-secret").update(stable(payload)).digest("hex"));
}
script:post-response {
  if (res.status === 200) bru.setEnvVar("completedTopupId", res.body.data.topupId);
}
tests {
  test("completes topup", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("success");
  });
}
